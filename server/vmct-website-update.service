[Unit]
Description=Check and deploy VMCT website updates
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/opt/vmct-website/.git

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/vmct-website/update.env
ExecStart=/usr/local/sbin/vmct-website-update
TimeoutStartSec=30min
