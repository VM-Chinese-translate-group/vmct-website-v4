# Merge these settings into /etc/vmct-website/update.env (mode 600).
# Required: the ESA site ID for vmct.top, not an edge routine/service ID.
ESA_SITE_ID=
ESA_REGION=cn-hangzhou
# Optional: an existing aliyun CLI profile available to the root update service.
# ESA_CLI_PROFILE=ecs-esa
# Optional: reuse the existing CLI config when it belongs to another user.
# ESA_CLI_CONFIG_PATH=/home/vmct/.aliyun/config.json

# Optional GitHub proxy. Keep local health checks off the proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
