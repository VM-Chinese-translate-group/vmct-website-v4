[Unit]
Description=VMCT website ECS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmct
WorkingDirectory=/opt/vmct-website
EnvironmentFile=/etc/vmct-website/api.env
ExecStart=/usr/bin/node --experimental-sqlite --experimental-strip-types server/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
