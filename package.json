{
  "name": "vmct-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/entry-server.ts && node scripts/build-api.mjs",
    "dev": "node scripts/build-api.mjs && node --experimental-sqlite scripts/dev.mjs",
    "start": "node --experimental-sqlite server/index.mjs",
    "api:start": "node scripts/build-api.mjs && node --experimental-sqlite server/index.mjs",
    "api:check": "node --experimental-sqlite --check server/index.mjs",
    "dictionary:import": "node --experimental-sqlite scripts/import-dictionary.mjs",
    "content:pull": "node scripts/sync-content.mjs",
    "content:migrate": "node scripts/migrate-legacy-content.mjs",
    "content:export": "node scripts/export-content.mjs",
    "api:build": "node scripts/build-api.mjs",
    "format": "prettier --write src/",
    "type-check": "vue-tsc --build",
    "test:site": "node scripts/build-api.mjs && node --test server/dynamic-site.test.mjs server/site-ssr.test.mjs server/downloads.test.mjs server/db.test.mjs scripts/nginx-deployment-config.test.mjs scripts/content-auth.test.mjs",
    "upgrade-deps": "taze patch -I"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@mdit/plugin-container": "^2.0.2",
    "@mdit/plugin-img-size": "^1.1.2",
    "@shikijs/markdown-it": "^4.5.0",
    "@vue/server-renderer": "^3.5.44",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "git-url-parse": "^16.1.0",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "opencc-js": "^1.4.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.44",
    "vue-easy-lightbox": "^1.19.0",
    "vue-i18n": "^11.4.14",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "pnpm": "12.13.0",
    "prettier": "3.9.5",
    "taze": "^21.3.0",
    "typescript": "6.0.3",
    "unocss": "^66.11.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.4",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22.16"
  }
}
